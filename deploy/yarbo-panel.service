[Unit]
Description=Yarbo PHP Control Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install.sh generates /etc/systemd/system/yarbo-panel.service with your user and paths.
# Or copy this file and adjust User, WorkingDirectory, and Environment.
User=pi
WorkingDirectory=/home/pi/yarbo-control-panel
Environment=YARBO_PANEL_HOST=0.0.0.0
Environment=YARBO_PANEL_PORT=8080
# Environment=YARBO_METRICS=0
# Environment=YARBO_METRICS_URL=https://yarbo-panel-metrics.YOUR-SUBDOMAIN.workers.dev/ping
ExecStart=/home/pi/yarbo-control-panel/scripts/panel.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
